# ---------------------------------------------------------------------------
# Database (PostgreSQL — e.g. Neon, Supabase, Prisma Postgres)
# ---------------------------------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection used for migrations. May equal DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Optional GitHub OAuth (leave blank to disable the GitHub button)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# AI provider (provider-agnostic)
# ---------------------------------------------------------------------------
# AI_PROVIDER=mock  -> deterministic offline provider (no API key required)
# AI_PROVIDER=openai -> any OpenAI-compatible /chat/completions endpoint
AI_PROVIDER="mock"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="30000"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email (optional) — password reset emails via Resend
# ---------------------------------------------------------------------------
# When both are set, reset links are emailed instead of shown in the UI.
RESEND_API_KEY=""
EMAIL_FROM="InterviewPrep <no-reply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Rate limiting (optional) — shared limiter via Upstash Redis REST
# ---------------------------------------------------------------------------
# Recommended for serverless / multi-instance deployments. Without these the
# limiter is in-memory and per-instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
