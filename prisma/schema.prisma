// InterviewPrep — Prisma schema
// Prisma 7 (prisma-client generator + driver adapter).
// Datasource URL lives in prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SOFTWARE_ENGINEER
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  FULL_STACK_DEVELOPER
  DATA_ANALYST
  DATA_SCIENTIST
  CYBERSECURITY_ANALYST
  DEVOPS_ENGINEER
  PRODUCT_MANAGER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InterviewType {
  TECHNICAL
  HR
  BEHAVIORAL
  MIXED
}

enum InterviewMode {
  PRACTICE
  REALISTIC
  RAPID_FIRE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QuestionType {
  TECHNICAL
  HR
  BEHAVIORAL
  CONCEPTUAL
  FOLLOW_UP
}

enum QuestionSource {
  AI
  QUESTION_BANK
}

// ---------------------------------------------------------------------------
// Auth.js models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  targetRole            Role?
  experienceLevel       ExperienceLevel?
  skills                String[]             @default([])
  preferredInterviewType InterviewType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
  interviews        Interview[]
  skillPerformance  SkillPerformance[]
  recommendations   Recommendation[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Interview domain
// ---------------------------------------------------------------------------

model Interview {
  id            String          @id @default(cuid())
  userId        String
  role          Role
  type          InterviewType
  mode          InterviewMode   @default(PRACTICE)
  difficulty    Difficulty
  questionCount Int
  topics        String[]        @default([])
  status        InterviewStatus @default(IN_PROGRESS)

  score               Float?
  technicalScore      Float?
  communicationScore  Float?
  problemSolvingScore Float?
  durationSec         Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions      InterviewQuestion[]
  recommendation Recommendation?

  @@index([userId, createdAt])
  @@map("interviews")
}

model InterviewQuestion {
  id               String         @id @default(cuid())
  interviewId      String
  order            Int
  question         String
  topic            String
  difficulty       Difficulty
  questionType     QuestionType
  expectedConcepts String[]       @default([])
  isFollowUp       Boolean        @default(false)
  parentQuestionId String?
  source           QuestionSource @default(AI)
  skipped          Boolean        @default(false)
  createdAt        DateTime       @default(now())

  interview Interview             @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  parent    InterviewQuestion?    @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: SetNull)
  followUps InterviewQuestion[]   @relation("QuestionFollowUps")
  answer    Answer?

  @@unique([interviewId, order])
  @@index([interviewId])
  @@map("interview_questions")
}

model Answer {
  id         String @id @default(cuid())
  questionId String @unique
  answer     String
  inputMode  String @default("text")

  score              Float?
  technicalScore     Float?
  completenessScore  Float?
  relevanceScore     Float?
  clarityScore       Float?
  communicationScore Float?
  feedback           Json?

  createdAt DateTime @default(now())

  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model SkillPerformance {
  id       String   @id @default(cuid())
  userId   String
  skill    String
  score    Float
  attempts Int      @default(1)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@map("skill_performance")
}

model QuestionBankItem {
  id                String         @id @default(cuid())
  role              Role?
  category          String
  topic             String
  difficulty        Difficulty
  questionType      QuestionType   @default(TECHNICAL)
  question          String         @unique
  expectedConcepts  String[]       @default([])
  idealAnswerPoints String[]       @default([])
  source            QuestionSource @default(QUESTION_BANK)
  validated         Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@index([category, difficulty])
  @@map("question_bank")
}

model Recommendation {
  id          String  @id @default(cuid())
  userId      String
  interviewId String? @unique
  summary     String
  items       Json
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("recommendations")
}
